{
  "name": "northcity-rulebook",
  "main": "worker.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "north-city-db",
      "database_id": "117dd489-c53d-40e5-9ff3-112b21093b93"
    }
  ]
}
